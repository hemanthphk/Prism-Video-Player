<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0a0a0f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="PRISM">
<title>PRISM — Video Player</title>
<style>
:root {
  --bg: #0a0a0f;
  --surface: #13131c;
  --surface2: #1c1c28;
  --surface3: #252533;
  --accent: #7c3aed;
  --accent2: #a855f7;
  --accent3: #c084fc;
  --cyan: #22d3ee;
  --pink: #f472b6;
  --text: #f0eeff;
  --text-dim: #8878aa;
  --text-muted: #4a4060;
  --border: rgba(124,58,237,0.22);
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bot: env(safe-area-inset-bottom, 0px);
}

*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}

html,body{
  width:100%;height:100%;overflow:hidden;
  font-family:'Segoe UI',system-ui,sans-serif;
  background:var(--bg);color:var(--text);
  user-select:none;-webkit-user-select:none;
}

/* ── BACKGROUND ── */
body::before{
  content:'';position:fixed;inset:0;
  background:
    radial-gradient(ellipse 70% 50% at 10% 10%, rgba(124,58,237,0.13) 0%,transparent 60%),
    radial-gradient(ellipse 50% 60% at 90% 90%, rgba(34,211,238,0.07) 0%,transparent 60%);
  pointer-events:none;z-index:0;
}

/* ══════════════════════════════════
   TOP BAR
══════════════════════════════════ */
.topbar{
  position:fixed;top:0;left:0;right:0;
  padding: calc(var(--safe-top) + 10px) 16px 10px;
  background:rgba(10,10,15,0.92);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(24px);
  display:flex;align-items:center;gap:12px;
  z-index:200;
}

.logo-btn{
  display:flex;align-items:center;gap:8px;
  background:none;border:none;cursor:pointer;padding:4px 8px 4px 0;
}

.logo-svg{
  width:32px;height:32px;
  filter:drop-shadow(0 0 8px rgba(168,85,247,0.9));
  transition:filter 0.3s;
}
.logo-btn:active .logo-svg{filter:drop-shadow(0 0 16px rgba(192,132,252,1));}

.logo-wordmark{
  font-size:18px;font-weight:800;letter-spacing:0.18em;
  background:linear-gradient(135deg,var(--accent3),var(--cyan));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}

.topbar-right{display:flex;align-items:center;gap:8px;margin-left:auto;}

.icon-btn{
  width:38px;height:38px;border-radius:10px;
  background:none;border:none;cursor:pointer;
  font-size:18px;color:var(--text-dim);transition:all 0.2s;
  display:flex;align-items:center;justify-content:center;
}
.icon-btn:active, .icon-btn.active{background:var(--surface2);color:var(--text);}

.import-btn{
  display:flex;align-items:center;gap:6px;
  padding:8px 14px;border-radius:10px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:white;border:none;cursor:pointer;
  font-size:13px;font-weight:700;letter-spacing:0.03em;
  box-shadow:0 0 16px rgba(124,58,237,0.4);
  transition:all 0.2s;white-space:nowrap;
}
.import-btn:active{transform:scale(0.96);box-shadow:0 0 8px rgba(124,58,237,0.3);}

/* ══════════════════════════════════
   SIDEBAR / LIBRARY DRAWER
══════════════════════════════════ */
.sidebar-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.6);
  z-index:150;opacity:0;pointer-events:none;
  transition:opacity 0.3s;backdrop-filter:blur(4px);
}
.sidebar-overlay.open{opacity:1;pointer-events:all;}

.sidebar{
  position:fixed;top:0;left:0;bottom:0;
  width:min(300px,85vw);
  background:rgba(13,13,22,0.98);
  border-right:1px solid var(--border);
  z-index:160;
  display:flex;flex-direction:column;
  transform:translateX(-100%);
  transition:transform 0.32s cubic-bezier(0.4,0,0.2,1);
  backdrop-filter:blur(30px);
}
.sidebar.open{transform:translateX(0);}

.sidebar-header{
  padding:calc(var(--safe-top) + 54px) 20px 16px;
  border-bottom:1px solid var(--border);
}
.sidebar-title{font-size:11px;font-weight:700;letter-spacing:0.15em;color:var(--text-muted);text-transform:uppercase;}

.sidebar-scroll{flex:1;overflow-y:auto;padding:12px 10px;}
.sidebar-scroll::-webkit-scrollbar{display:none;}

.sb-section-label{
  font-size:9px;font-weight:700;letter-spacing:0.15em;
  color:var(--text-muted);text-transform:uppercase;
  padding:12px 10px 6px;
}

.sb-item{
  display:flex;align-items:center;gap:12px;
  padding:11px 12px;border-radius:10px;cursor:pointer;
  font-size:14px;font-weight:500;color:var(--text-dim);
  transition:all 0.18s;margin-bottom:2px;position:relative;
}
.sb-item:active,.sb-item.active{
  color:var(--accent3);background:rgba(124,58,237,0.14);
}
.sb-item.active::before{
  content:'';position:absolute;left:0;top:20%;bottom:20%;
  width:3px;background:var(--accent2);border-radius:0 3px 3px 0;
  box-shadow:0 0 8px var(--accent2);
}
.sb-item .si{font-size:18px;width:24px;text-align:center;}

.sb-badge{
  margin-left:auto;font-size:10px;font-weight:700;
  background:var(--accent);color:white;
  padding:2px 7px;border-radius:20px;
}

.sidebar-footer{
  padding:16px 16px calc(var(--safe-bot) + 16px);
  border-top:1px solid var(--border);
}
.sidebar-footer p{font-size:11px;color:var(--text-muted);line-height:1.5;}

/* ══════════════════════════════════
   MAIN SCROLL AREA
══════════════════════════════════ */
.main{
  position:fixed;inset:0;
  padding-top:calc(var(--safe-top) + 60px);
  padding-bottom:calc(var(--safe-bot) + 72px);
  overflow-y:auto;overflow-x:hidden;
  -webkit-overflow-scrolling:touch;
  z-index:1;
}
.main::-webkit-scrollbar{display:none;}

/* ── EMPTY STATE ── */
.empty-state{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:60vh;padding:40px 32px;text-align:center;gap:16px;
}
.empty-icon{font-size:64px;opacity:0.3;}
.empty-title{font-size:20px;font-weight:700;color:var(--text);}
.empty-sub{font-size:14px;color:var(--text-muted);line-height:1.6;max-width:260px;}
.empty-cta{
  margin-top:8px;padding:12px 28px;border-radius:12px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:white;border:none;cursor:pointer;
  font-size:15px;font-weight:700;letter-spacing:0.03em;
  box-shadow:0 0 24px rgba(124,58,237,0.45);
  transition:all 0.2s;
}
.empty-cta:active{transform:scale(0.96);}

/* ── SECTION HEADER ── */
.section-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 16px 12px;
}
.section-head h2{font-size:16px;font-weight:700;}
.section-count{font-size:11px;color:var(--text-muted);font-weight:600;}

/* ── SEARCH BAR ── */
.search-wrap{padding:0 16px 12px;}
.search-box{
  display:flex;align-items:center;gap:10px;
  background:var(--surface2);border:1px solid var(--border);
  border-radius:12px;padding:10px 14px;
}
.search-box span{font-size:16px;color:var(--text-muted);}
.search-box input{
  flex:1;background:none;border:none;outline:none;
  color:var(--text);font-size:14px;
}
.search-box input::placeholder{color:var(--text-muted);}

/* ── GRID ── */
.video-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;padding:0 16px 16px;
}
@media(min-width:500px){.video-grid{grid-template-columns:repeat(3,1fr);}}
@media(min-width:700px){.video-grid{grid-template-columns:repeat(4,1fr);}}

.vcard{
  background:var(--surface);border:1px solid rgba(255,255,255,0.04);
  border-radius:14px;overflow:hidden;cursor:pointer;
  transition:transform 0.18s,box-shadow 0.18s;
  position:relative;
}
.vcard:active{transform:scale(0.96);box-shadow:0 0 24px rgba(124,58,237,0.3);}

.vcard-thumb{
  width:100%;aspect-ratio:16/9;
  background:var(--surface3);position:relative;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.vcard-thumb img{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;
}
.thumb-placeholder{font-size:32px;opacity:0.2;position:relative;z-index:1;}
.thumb-play{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,0.35);opacity:0;transition:opacity 0.2s;z-index:2;
}
.vcard:active .thumb-play{opacity:1;}
.play-circle{
  width:44px;height:44px;border-radius:50%;
  background:rgba(124,58,237,0.88);
  display:flex;align-items:center;justify-content:center;
  font-size:16px;color:white;padding-left:3px;
  box-shadow:0 0 20px rgba(124,58,237,0.6);
}
.vcard-dur{
  position:absolute;bottom:6px;right:6px;z-index:3;
  background:rgba(0,0,0,0.75);color:white;
  font-size:10px;font-weight:700;padding:2px 6px;border-radius:5px;
  letter-spacing:0.04em;
}
.vcard-res{
  position:absolute;top:6px;left:6px;z-index:3;
  background:var(--accent);color:white;
  font-size:9px;font-weight:700;padding:2px 6px;border-radius:5px;
  letter-spacing:0.05em;
}
.vcard-fav-indicator{
  position:absolute;top:6px;right:6px;z-index:3;
  color:var(--pink);font-size:14px;
  filter: drop-shadow(0 1px 2px rgba(0,0,0,0.8));
}
.vcard-info{padding:9px 10px;}
.vcard-title{
  font-size:12px;font-weight:600;color:var(--text);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:3px;
}
.vcard-meta{font-size:10px;color:var(--text-muted);}

/* ── SETTINGS PANEL ── */
.settings-panel{
  padding:20px 16px;
  display:flex;flex-direction:column;gap:20px;
}
.settings-group{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:14px;padding:16px;
}
.settings-group h3{font-size:14px;margin-bottom:12px;color:var(--accent3);text-transform:uppercase;letter-spacing:0.05em;}
.settings-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.04);
}
.settings-row:last-child{border-bottom:none;}
.settings-row label{font-size:13px;color:var(--text-dim);}
.settings-select, .settings-input{
  background:var(--surface2);border:1px solid var(--border);
  color:var(--text);padding:6px 12px;border-radius:8px;font-size:13px;outline:none;
}
.danger-btn{
  width:100%;padding:12px;background:rgba(244,114,182,0.1);
  color:var(--pink);border:1px solid rgba(244,114,182,0.3);
  border-radius:10px;font-weight:700;cursor:pointer;transition:all 0.2s;
}
.danger-btn:active{background:rgba(244,114,182,0.2);transform:scale(0.98);}

/* ── VIDEO PLAYER OVERLAY ── */
.player-overlay{
  position:fixed;inset:0;background:#000;z-index:300;
  display:flex;flex-direction:column;
  transform:translateY(100%);
  transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
}
.player-overlay.open{transform:translateY(0);}

#mainVideo{width:100%;height:100%;object-fit:contain;background:#000;}

.player-controls{
  position:absolute;bottom:0;left:0;right:0;
  padding:16px 16px calc(var(--safe-bot) + 12px);
  background:linear-gradient(transparent,rgba(0,0,0,0.85) 40%,rgba(0,0,0,0.95));
  transition:opacity 0.3s;
}
.player-controls.hidden{opacity:0;pointer-events:none;}

.progress-row{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
.time-lbl{font-size:11px;color:rgba(255,255,255,0.7);font-weight:600;white-space:nowrap;min-width:42px;}
.time-lbl.r{text-align:right;}
.prog-track{
  flex:1;height:4px;background:rgba(255,255,255,0.2);
  border-radius:2px;cursor:pointer;position:relative;
  transition:height 0.15s;
}
.prog-track:hover, .prog-track:active{height:8px;}
.prog-fill{
  height:100%;background:linear-gradient(90deg,var(--accent),var(--accent3));
  border-radius:2px;position:relative;pointer-events:none;
}
.prog-thumb{
  position:absolute;right:-6px;top:50%;transform:translateY(-50%);
  width:12px;height:12px;background:white;border-radius:50%;
  box-shadow:0 0 8px rgba(124,58,237,0.8);
}

.ctrl-row{display:flex;align-items:center;justify-content:space-evenly;}
.ctrl-btn{
  width:48px;height:48px;border-radius:50%;
  background:none;border:none;cursor:pointer;
  color:white;font-size:22px;
  display:flex;align-items:center;justify-content:center;
  transition:background 0.15s;
}
.ctrl-btn:active{background:rgba(255,255,255,0.12);}
.ctrl-btn.main-play{
  width:60px;height:60px;font-size:28px;
  background:rgba(124,58,237,0.8);
  box-shadow:0 0 24px rgba(124,58,237,0.6);
}
.ctrl-btn.main-play:active{background:rgba(124,58,237,1);}

/* player header (back + title) */
.player-header{
  position:absolute;top:0;left:0;right:0;
  padding:calc(var(--safe-top) + 10px) 16px 10px;
  display:flex;align-items:center;gap:10px;
  background:linear-gradient(rgba(0,0,0,0.7),transparent);
  transition:opacity 0.3s;
}
.player-header.hidden{opacity:0;pointer-events:none;}
.back-btn{
  width:38px;height:38px;border-radius:50%;background:rgba(0,0,0,0.4);
  border:none;cursor:pointer;color:white;font-size:20px;
  display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(8px);
}
.player-vid-title{
  flex:1;font-size:14px;font-weight:600;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  text-shadow:0 1px 6px rgba(0,0,0,0.8);
}

/* volume & utility slider */
.vol-row{display:flex;align-items:center;gap:12px;margin-bottom:12px;padding:0 8px;}
.vol-icon{font-size:16px;cursor:pointer;}
.vol-track{
  flex:1;height:4px;background:rgba(255,255,255,0.2);
  border-radius:2px;cursor:pointer;
}
.vol-fill{height:100%;background:rgba(255,255,255,0.8);border-radius:2px;width:100%;}
.player-util-btn{
  background:none;border:none;color:white;font-size:18px;cursor:pointer;padding:4px;
}

/* ── BOTTOM NAV ── */
.bottom-nav{
  position:fixed;bottom:0;left:0;right:0;
  padding:8px 0 calc(var(--safe-bot) + 6px);
  background:rgba(10,10,15,0.95);
  border-top:1px solid var(--border);
  display:flex;justify-content:space-around;
  z-index:200;backdrop-filter:blur(20px);
}
.nav-tab{
  display:flex;flex-direction:column;align-items:center;gap:3px;
  padding:6px 20px;border:none;background:none;cursor:pointer;
  color:var(--text-muted);font-size:10px;font-weight:600;
  letter-spacing:0.04em;transition:color 0.2s;
}
.nav-tab .tab-icon{font-size:20px;}
.nav-tab.active{color:var(--accent3);}

/* ── TOAST ── */
.toast{
  position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--surface2);border:1px solid var(--border);
  color:var(--text);font-size:13px;font-weight:600;
  padding:10px 20px;border-radius:12px;z-index:500;
  opacity:0;transition:all 0.3s;pointer-events:none;white-space:nowrap;
  box-shadow:0 4px 20px rgba(0,0,0,0.4);
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<div class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="sidebar-title">📁 Library</div>
  </div>
  <div class="sidebar-scroll">
    <div class="sb-section-label">Sections</div>
    <div class="sb-item active" id="sbItem-all" onclick="switchFilterMode('all')">
      <span class="si">🎬</span> All Videos <span class="sb-badge" id="sbAll">0</span>
    </div>
    <div class="sb-item" id="sbItem-recent" onclick="switchFilterMode('recent')">
      <span class="si">🕐</span> Recently Added
    </div>
    <div class="sb-item" id="sbItem-watched" onclick="switchFilterMode('watched')">
      <span class="si">✅</span> Watched
    </div>
    <div class="sb-item" id="sbItem-fav" onclick="switchFilterMode('fav')">
      <span class="si">♥</span> Favourites
    </div>
    <div class="sb-section-label" style="margin-top:8px;">Formats</div>
    <div class="sb-item" id="sbItem-mp4" onclick="switchFormatMode('mp4')">
      <span class="si">📦</span> MP4
    </div>
    <div class="sb-item" id="sbItem-mkv" onclick="switchFormatMode('mkv')">
      <span class="si">📦</span> MKV
    </div>
    <div class="sb-item" id="sbItem-mov" onclick="switchFormatMode('mov')">
      <span class="si">📦</span> MOV / Other
    </div>
  </div>
  <div class="sidebar-footer">
    <p>Tap the <strong>PRISM</strong> logo anytime to open or close the library panel.</p>
  </div>
</div>

<div class="topbar" id="topBar">
  <button class="logo-btn" onclick="toggleSidebar()" title="Toggle Library">
    <svg class="logo-svg" viewBox="0 0 40 40" fill="none">
      <polygon points="6,5 38,20 6,35" fill="url(#lg)"/>
      <defs>
        <linearGradient id="lg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#a855f7"/>
          <stop offset="100%" stop-color="#22d3ee"/>
        </linearGradient>
      </defs>
    </svg>
    <span class="logo-wordmark">PRISM</span>
  </button>
  <div class="topbar-right">
    <button class="icon-btn" id="searchToggleBtn" onclick="toggleSearch()" title="Search">🔍</button>
    <button class="import-btn" onclick="document.getElementById('filePicker').click()">
      ＋ Add Videos
    </button>
  </div>
</div>

<input type="file" id="filePicker" accept="video/*,.mkv,.avi,.wmv,.flv,.webm,.mov,.m4v,.ts,.m2ts" multiple style="display:none" onchange="importFiles(this.files)">

<div class="main" id="main">

  <div class="search-wrap" id="searchWrap" style="display:none;padding-top:12px;">
    <div class="search-box">
      <span>🔍</span>
      <input type="text" id="searchInput" placeholder="Search videos…" oninput="doSearch(this.value)">
    </div>
  </div>

  <div class="empty-state" id="emptyState">
    <div class="empty-icon">🎬</div>
    <div class="empty-title">No Videos Yet</div>
    <div class="empty-sub">Tap the button below to pick videos from your device. All metadata and progression parameters are saved natively.</div>
    <button class="empty-cta" onclick="document.getElementById('filePicker').click()">＋ Import Videos</button>
  </div>

  <div id="libraryView" style="display:none;">
    <div class="section-head">
      <h2 id="sectionLabel">All Videos</h2>
      <span class="section-count" id="sectionCount"></span>
    </div>
    <div class="video-grid" id="videoGrid"></div>
  </div>

  <div id="settingsView" style="display:none;" class="settings-panel">
    <div class="settings-group">
      <h3>System Configurations</h3>
      <div class="settings-row">
        <label>Primary Interface Spectrum</label>
        <select class="settings-select" id="cfgAccent" onchange="updateAccentColor(this.value)">
          <option value="#7c3aed">Amethyst Purple</option>
          <option value="#3b82f6">Cobalt Blue</option>
          <option value="#10b981">Emerald Green</option>
          <option value="#ec4899">Neon Pink</option>
          <option value="#f59e0b">Amber Gold</option>
        </select>
      </div>
      <div class="settings-row">
        <label>Default Playback Velocity</label>
        <select class="settings-select" id="cfgSpeed" onchange="updatePlaybackVelocity(this.value)">
          <option value="0.5">0.50x (Slow)</option>
          <option value="1.0" selected>1.00x (Standard)</option>
          <option value="1.25">1.25x</option>
          <option value="1.5">1.50x</option>
          <option value="2.0">2.00x (Fast)</option>
        </select>
      </div>
    </div>

    <div class="settings-group">
      <h3>Database Operations</h3>
      <p style="font-size:12px; color:var(--text-dim); margin-bottom:12px; line-height:1.4;">
        Clearing system runtime records wipes metadata cache allocations alongside virtual persistent references.
      </p>
      <button class="danger-btn" onclick="clearApplicationDatabase()">Purge Core Storage System</button>
    </div>
  </div>

</div>

<div class="bottom-nav">
  <button class="nav-tab active" id="navTab-home" onclick="handleTabSwitch(this,'home')">
    <span class="tab-icon">⌂</span>Home
  </button>
  <button class="nav-tab" id="navTab-videos" onclick="handleTabSwitch(this,'videos')">
    <span class="tab-icon">▶</span>Videos
  </button>
  <button class="nav-tab" id="navTab-fav" onclick="handleTabSwitch(this,'fav')">
